# Copy to .env.local for local dev. On Vercel, add these under Project > Settings > Environment Variables.

# Public URL of the site (no trailing slash). Change when the domain is bought, then redeploy.
NEXT_PUBLIC_SITE_URL=https://second-turn.vercel.app

# Neon Postgres (added automatically when you connect Neon through Vercel Storage).
# Use a NEW database for this shop. Tables are prefixed bg_, so a shared one is safe, but separate is tidier.
DATABASE_URL=

# Vercel Blob for photos (added automatically when you create a Blob store in the Vercel project)
BLOB_READ_WRITE_TOKEN=

# Stripe (same account as your other shops; this shop tags its payments site=boardgames)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend for order emails
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Second Turn <orders@secondturn.co.nz>"
EMAIL_FROM=
# Where your "you made a sale" emails go
OWNER_EMAIL=

# Turns on the follow-up email to buyers who opted in at checkout (Vercel Cron, daily).
# Any long random string; Vercel sends it to the cron route automatically.
CRON_SECRET=

# /admin login
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Any long random string, e.g. output of: openssl rand -base64 32
SESSION_SECRET=
